{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**" },
        { "path": "/**" },
        { "path": "$HOME/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "shell:allow-open",
    "core:app:allow-set-app-theme",
    "dialog:default"
  ],
  "shell": {
    "execute": true,
    "open": true
  }
}
